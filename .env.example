DATABASE_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

ANTHROPIC_API_KEY=
# messages per user per day, atomically reserved server-side
CHAT_DAILY_QUOTA=

# decompressed/cloned size cap in bytes (default 209715200 = 200MB)
IMPORT_MAX_BYTES=
# file-count cap, checked during extraction/clone (default 20000)
IMPORT_MAX_FILES=

# parse_jobs retries before a project is marked 'error' for good (default 3)
PARSE_MAX_ATTEMPTS=
# a 'processing' job older than this (minutes) is assumed hung and reclaimed (default 15)
PARSE_STALE_TIMEOUT_MIN=

# Production (adapter-node) only: max request body. Default 512K is too small for
# uploads — set it to at least IMPORT_MAX_BYTES, e.g. 210M.
# BODY_SIZE_LIMIT=210M

# Optional — only needed once billing is turned on
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
