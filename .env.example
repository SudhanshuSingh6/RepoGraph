DATABASE_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

ANTHROPIC_API_KEY=
# messages per user per day, atomically reserved server-side
CHAT_DAILY_QUOTA=

# decompressed/cloned size cap in bytes
IMPORT_MAX_BYTES=
# file-count cap, checked during extraction/clone
IMPORT_MAX_FILES=

# parse_jobs retries before a project is marked 'error' for good
PARSE_MAX_ATTEMPTS=
# a 'processing' job older than this (minutes) is assumed hung and reclaimed
PARSE_STALE_TIMEOUT_MIN=

# Optional — only needed once billing is turned on
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
